# Copy to .env.local and fill in keys you want to use.
# The app runs fully in demo mode with no keys.

# OpenWeatherMap — current conditions at catch time + 5-day forecast for Plan
# https://openweathermap.org/api
OPENWEATHER_API_KEY=

# OpenAI — fish species assist from a photo (https://platform.openai.com/)
# Real ID (species + freshwater vs inshore/offshore hint). Confirm or edit every time.
OPENAI_API_KEY=
# Optional override (default: gpt-4o). gpt-4o-mini is cheaper but weaker on similar fish.
OPENAI_VISION_MODEL=gpt-4o

# WorldTides — optional tide extremes for coastal spots on the Plan page
# https://www.worldtides.info/
WORLDTIDES_API_KEY=

# Optional: override SQLite path (default: ./data/cast-log.sqlite)
# DATABASE_PATH=
