# Copy to .env.local and fill in keys you want to use.
# The app runs fully in demo mode with no keys.

# OpenWeatherMap — current conditions at catch time + 5-day forecast for Plan
# https://openweathermap.org/api
OPENWEATHER_API_KEY=

# OpenAI — parked. Species auto-ID is off; you pick fish from the list.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o

# WorldTides — optional worldwide tide extremes for catch weather + Plan
# https://www.worldtides.info/
# Without this key, catch weather uses free NOAA CO-OPS stations (US coasts,
# no key). Freshwater / inland pins do not invent ocean tides.
WORLDTIDES_API_KEY=

# Maps use Esri World Imagery (satellite) and OpenStreetMap (street). No key.

# Optional: override SQLite path (default: ./data/cast-log.sqlite)
# DATABASE_PATH=

# Optional: catch/bait photo directory (default: ./data/uploads)
# UPLOADS_DIR=

# Turso / LibSQL — durable remote journal (leave unset for local SQLite)
# https://turso.tech — free DB is enough
# TURSO_DATABASE_URL=libsql://your-db-name-org.turso.io
# TURSO_AUTH_TOKEN=
# DATABASE_URL=libsql://...   # also works; TURSO_DATABASE_URL wins if both are set
# LIBSQL_AUTH_TOKEN=          # alias for TURSO_AUTH_TOKEN
