# Copy to .env.local and fill in keys you want to use.
# The app runs fully in demo mode with no keys.

# OpenWeatherMap — current conditions at catch time + 5-day forecast for Plan
# https://openweathermap.org/api
OPENWEATHER_API_KEY=

# OpenAI — optional fish-photo detector for Find fishing photos in your library.
# Species on Log and Backfill is picked by hand from the saltwater catalog.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o

# WorldTides — optional fallback when no NOAA CO-OPS station is nearby
# https://www.worldtides.info/
# Catch weather and Plan use the nearest NOAA station on US coasts (no key).
# Freshwater / inland pins do not invent ocean tides.
WORLDTIDES_API_KEY=

# Maps use Esri World Imagery (satellite) and OpenStreetMap (street). No key.

# --- Hosted Tide Mark (Render / Railway). Leave unset on a laptop. ---
# NODE_ENV=production
# TURSO_DATABASE_URL=libsql://your-db-name-org.turso.io
# TURSO_AUTH_TOKEN=
# UPLOADS_DIR=/var/data/uploads
# PORT is set by the host. Do not hardcode it.
# DATABASE_URL=libsql://...   # alias; TURSO_DATABASE_URL wins if both are set
# LIBSQL_AUTH_TOKEN=          # alias for TURSO_AUTH_TOKEN

# Optional: override SQLite path on a laptop (default: ./data/cast-log.sqlite)
# DATABASE_PATH=

# Optional: catch/bait photo directory on a laptop (default: ./data/uploads)
# UPLOADS_DIR=

# --- Trial / entitlement QA (leave unset on the public host) ---
# First-month length. Default 30. Use a fraction (e.g. 0.001) for a short QA trial.
# TIDEMARK_TRIAL_DAYS=30
# Force every signed-in journal to trial | active | expired. Do not set in production.
# TIDEMARK_FORCE_ENTITLEMENT=
# If set, POST /api/entitlement/qa with the same secret (body.secret or x-tidemark-qa)
# can mark the signed-in journal expired / trial / active. No public unlock button.
# TIDEMARK_QA_SECRET=

# Tide Mark Plan gate applies only when the iOS shell reports version 2.0+
# and build >= 14 (TideMarkPlanIAP/2 TideMarkBuild/14) and TideMarkStore
# purchase is available. The website, Android, Tide Mark 1.0, and older
# TestFlight builds keep free logging. StoreKit, including an active trial,
# decides access on that shell.
# Accounts that always keep full access. Unset uses the owner default.
# Do not add the App Review demo account.
# COMP_ACCOUNT_EMAILS=johndavidheard2002@gmail.com,jd@southtexascharters.com

# Forgot password: reset links are emailed through Gmail SMTP (smtp.gmail.com:465, TLS).
# GMAIL_USER and GMAIL_APP_PASSWORD are both required to send. Without them the form
# still answers generically, the server logs the missing var, and nothing is sent.
# GMAIL_APP_PASSWORD is a 16-character Google app password (2-Step Verification on).
# GMAIL_USER=fisharansaspass@gmail.com
# GMAIL_APP_PASSWORD=
# Optional. Default: Tide Mark <GMAIL_USER>
# MAIL_FROM=Tide Mark <fisharansaspass@gmail.com>
# Origin used in reset links. Production defaults to the Render URL.
# APP_BASE_URL=https://fishing-catch-log-ivl7.onrender.com
